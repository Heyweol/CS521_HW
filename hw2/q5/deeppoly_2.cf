def Shape as (Float l, Float u, PolyExp L, PolyExp U){
    [(curr[l]<=curr), (curr[u]>=curr),
    (curr[L]<=curr), (curr[U]>=curr)]
};

func slopeL(Float l, Float u) = (1 - l)/(u - l);
func slopeU(Float l, Float u) = (u + 1)/(u - l);
func priority(Neuron n) = n[layer];
func stop(Neuron n) = false;

transformer deeppoly_2{
    HardTanh -> ((prev[l])>=1) ?
        (1, 1, 1, 1) :
        (((prev[u])<=-1) ?
            (-1, -1, -1, -1) :
            ((prev[l]>=-1) and (prev[u]<=1) ?
                (prev[l], prev[u], prev, prev) :
                (prev[l]>-1 ?
                    (prev[l], 1, (slopeL(prev[l], prev[u]) * prev) + (1 - (slopeL(prev[l], prev[u]) * prev[u])), 1) :
                    (prev[u]<1 ?
                        (-1, prev[u], (slopeU(prev[l], prev[u]) * prev) - slopeU(prev[u], prev[l]), (slopeU(prev[l], prev[u]) * prev) + (slopeU(prev[u], prev[l]) * prev[u])) :
                        (-1, 1, (2/(prev[u] - prev[l])) * prev - ((prev[u] - prev[l] - 2) / (prev[u] - prev[l])), (2/(prev[u] - prev[l])) * prev + ((prev[u] - prev[l] - 2) / (prev[u] - prev[l])))
                    )
                )
            )
        );
}
flow(forward, priority, stop, deeppoly_2);